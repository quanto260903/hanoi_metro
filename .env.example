# ==============================================================================
# HANOI METRO AI AGENT - MẪU CẤU HÌNH (.env)
# Sao chép thành .env rồi điền khóa thật. KHÔNG đưa .env vào mã nguồn hay tài liệu.
# Cấu hình hiện dùng: LLM và VLM qua API OpenAI (gpt-6-luna); nhúng bge-m3 qua Ollama trên máy;
# tìm kiếm Qdrant + SQLite FTS5; dịch vụ hỏi đáp 1 lượt (gateway) cho LibreChat.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VLM qua API (bóc tách trang ảnh: luồng VLM và STANDARD_OCR của page_router)
# ------------------------------------------------------------------------------
VLM_PROVIDER=openai
VLM_BASE_URL=https://api.openai.com/v1
VLM_API_KEY=<khóa API OpenAI>
VLM_MODEL_NAME=gpt-6-luna
VLM_MAX_TOKENS=16384
VLM_TIMEOUT_SECONDS=180
# Ảnh 150 DPI, cả trang một ảnh, detail=high (OpenAI không cần cắt dải)
IMAGE_DPI_VLM=150
VLM_STRIPS=1
VLM_IMAGE_DETAIL=high
# Để trống với OpenAI; "none" chỉ dùng khi quay lại Gemini 2.5 Flash (tắt thinking)
VLM_REASONING_EFFORT=
# Trần ngân sách cứng (USD, cộng dồn mọi lần chạy, tính cả lô Batch đang chờ). Đặt bằng mức được duyệt.
VLM_BUDGET_USD=1.0
# Đơn giá tham khảo gpt-6-luna (USD / 1 triệu token) - đối chiếu bảng giá chính thức trước khi chạy toàn kho
VLM_PRICE_IN_PER_M=0.10
VLM_PRICE_OUT_PER_M=0.50
VLM_BATCH_DISCOUNT=0.5

# Bóc tách toàn kho theo kết quả page_router (python -m src.ingestion.corpus ...)
CORPUS_ROOT=D:/40GB
CORPUS_RESULTS_DIR=D:/40GB/_phan_tich_chi_phi_VLM/ket_qua
CORPUS_MD_DIR=data/corpus_md
# vlm (mặc định) | rapidocr (RapidOCR mặc định làm mất dấu tiếng Việt)
CORPUS_OCR_VIA=vlm

# ------------------------------------------------------------------------------
# 2. LLM cho hỏi đáp / tóm tắt / soạn thảo (qua API OpenAI)
# ------------------------------------------------------------------------------
# auto: địa chỉ chứa 11434 thì dùng Ollama, còn lại dùng API tương thích OpenAI
LLM_PROVIDER=auto
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=<khóa API OpenAI>
LLM_MODEL_NAME=gpt-6-luna
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=6144
LLM_TIMEOUT_SECONDS=90
LLM_REASONING_EFFORT=
# Chỉ dùng khi LLM chạy Ollama
LLM_NUM_CTX=16384

# ------------------------------------------------------------------------------
# 3. EMBEDDING bge-m3 chạy trên máy qua Ollama (không cần GPU)
# ------------------------------------------------------------------------------
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL_NAME=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=45

# ------------------------------------------------------------------------------
# 4. QDRANT
# ------------------------------------------------------------------------------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# Bắt buộc đặt khi triển khai lên máy chủ
QDRANT_API_KEY=
QDRANT_CHUNKS_COLLECTION=hanoi_metro_chunks
# Qdrant nhúng khi không kết nối được server (một tiến trình; đổi chế độ phải chạy lại index --force)
QDRANT_LOCAL_PATH=data/qdrant_local
# Collection của giai đoạn 1 (không dùng trên luồng hiện tại)
QDRANT_COLLECTION_NAME=hanoi_metro_documents

# ------------------------------------------------------------------------------
# 5. DANH SÁCH CHẶN TÀI LIỆU MẬT (BẮT BUỘC)
# ------------------------------------------------------------------------------
# Thư mục kết quả page_router chứa restricted_md5.txt / blocklist_md5.txt / allowlist_md5.txt.
# Thiếu thư mục này hoặc thiếu restricted_md5.txt: hệ thống TỪ CHỐI mọi lần gửi tài liệu ra API (fail-closed).
BLOCKLIST_DIR=D:/40GB/_phan_tich_chi_phi_VLM/ket_qua

# ------------------------------------------------------------------------------
# 6. CHỈ MỤC VÀ TÌM KIẾM
# ------------------------------------------------------------------------------
# sqlite (đang dùng, một máy) | postgres (đã viết, chưa kiểm thử)
KEYWORD_BACKEND=sqlite
SQLITE_INDEX_PATH=data/index.sqlite
# POSTGRES_DSN=postgresql://hanoi_metro:<mật_khẩu>@localhost:5432/hanoi_metro
SYNONYM_DICT_PATH=data/dictionaries/synonym_dict.json

# Chunking (token ước lượng)
CHUNK_H1_SINGLE_MAX=1000
CHUNK_CHILD_MIN=250
CHUNK_CHILD_MAX=500
CHUNK_PARENT_MAX=2000
CHUNK_OVERLAP=60
CHUNK_H2_ARTICLE_MAX=800
CHUNK_TABLE_SINGLE_MAX=600
CHUNK_TABLE_ROWS=20

# Tìm kiếm lai: RRF k=60, 50 ứng viên mỗi nhánh, tối đa 3 đoạn / văn bản, mở rộng mục cha cho 6 kết quả đầu
RRF_K=60
SEARCH_BRANCH_K=50
SEARCH_MAX_CHUNKS_PER_DOC=3
SEARCH_FINAL_K=8
SEARCH_PARENT_EXPAND=6
# auto: chỉ bật bge-reranker-v2-m3 khi đã cài FlagEmbedding (hiện chưa cài); on: bắt buộc; off: tắt
RERANK=auto

# ------------------------------------------------------------------------------
# 7. TRỢ LÝ, GATEWAY HỎI ĐÁP 1 LƯỢT, MCP
# ------------------------------------------------------------------------------
AGENT_TEMPERATURE=0.1
AGENT_CONTEXT_BUDGET_TOKENS=6000
AGENT_SUMMARY_BATCH_TOKENS=3000
# AGENT_ORGANIZATION=CÔNG TY TNHH MTV ĐƯỜNG SẮT HÀ NỘI

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8766
# Khóa LibreChat gửi trong header Authorization (đặt cùng giá trị cho HANOI_METRO_GATEWAY_KEY trong .env của LibreChat)
GATEWAY_API_KEY=<chuỗi ngẫu nhiên dài>

# MCP server (kênh phụ; LibreChat trong Docker gọi http://host.docker.internal:8765/mcp)
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,host.docker.internal:*

# --- Mở tài liệu gốc từ trích dẫn (gateway /tai-lieu/...) ---
# Địa chỉ trình duyệt người dùng mở được gateway (trên server: http://<ip-server>:8766). Trống = http://GATEWAY_HOST:GATEWAY_PORT
DOC_LINK_BASE_URL=
# Khóa ký liên kết; trống = suy ra từ GATEWAY_API_KEY. Đổi khóa sẽ làm liên kết cũ trong lịch sử chat hết hiệu lực.
DOC_LINK_SECRET=
# Thư mục chứa file gốc được phép mở (cách nhau bởi ;)
DOC_ROOTS=D:/40GB;data/raw_pdfs

# ------------------------------------------------------------------------------
# 8. GIAI ĐOẠN 1 (pipeline.py / classifier.py - không dùng trên luồng hiện tại)
# ------------------------------------------------------------------------------
RAW_PDFS_DIR=data/raw_pdfs
PROCESSED_MD_DIR=data/processed_md
# Thư mục của STATE_DB_PATH cũng chứa sổ cái VLM vlm_ledger.db
STATE_DB_PATH=data/state.db
LOG_LEVEL=INFO
IMAGE_DPI=300
IMAGE_RATIO_THRESHOLD=0.15
CLASSIFIER_BLUR_THRESHOLD=90.0
CLASSIFIER_SKEW_THRESHOLD=1.5
MIN_TEXT_CHARS_DIRECT=120
MAX_FONT_ERROR_RATIO=0.03
COMPLEX_TABLE_CELL_THRESHOLD=4

# ------------------------------------------------------------------------------
# Quay lại Gemini 2.5 Flash (dự phòng) - chỉ đổi cấu hình, không sửa mã:
# VLM_PROVIDER=gemini
# VLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# VLM_MODEL_NAME=gemini-2.5-flash
# VLM_STRIPS=3
# IMAGE_DPI_VLM=200
# VLM_IMAGE_DETAIL=
# VLM_REASONING_EFFORT=none
# VLM_PRICE_IN_PER_M=0.30
# VLM_PRICE_OUT_PER_M=2.50
# ------------------------------------------------------------------------------

# --- Phân quyền theo phòng ban (src/access; cấu hình trong config/access/) ---
# off = mọi người dùng xem toàn bộ kho (như trước). on = tra nguoi_dung.csv / vai_tro.yaml, lọc theo nhãn phòng của văn bản.
ACCESS_CONTROL=off
ACCESS_CONFIG_DIR=config/access
ACCESS_USER_HEADER=x-user-email
ACCESS_LOG=data/access_log.jsonl
# Sổ khai báo phòng ban (/phongban) và kết quả duyệt
ACCESS_REGISTRATIONS=data/access/dang_ky.csv
# Khi bật phân quyền: liên kết mở file gắn với người dùng và hết hạn sau N giờ (0 = không hết hạn)
DOC_LINK_TTL_HOURS=24

# ---- Bổ sung metadata văn bản (python -m src.indexing.enrich) ----
# Thư mục kết quả page_router (pages_routed.csv) để tính tỷ lệ trang scan
CORPUS_RESULTS_DIR=D:\40GB\_phan_tich_chi_phi_VLM\ket_qua
# Tỷ lệ trang đọc được dưới ngưỡng này -> câu trả lời kèm ghi chú "nên xem bản gốc"
ENRICH_LOW_READ_RATIO=0.8
# Bước AI (chỉ khi chạy với --ai): hạn mức riêng, cộng dồn mọi lần chạy; giá dùng để ước tính chi phí
ENRICH_AI_BUDGET_USD=1.0
ENRICH_PRICE_IN_PER_M=0.10
ENRICH_PRICE_OUT_PER_M=0.50
ENRICH_AI_LEDGER=data/enrich_ai_ledger.sqlite
# Mức suy luận cho bước AI phân loại (riêng với LLM_REASONING_EFFORT của gateway); none làm mô hình trả rỗng hàng loạt
ENRICH_REASONING_EFFORT=low
